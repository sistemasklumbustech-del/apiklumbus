# Copia este archivo a ".env" (sin el ".example") y pon tus datos reales.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore) porque
# tiene tu contraseña real de Postgres.

# Puerto del backend (hallazgo real, 19-ago-2026): sin esta variable,
# el backend cae al puerto 3000 por defecto (ver apps/api/src/main.ts,
# `app.listen(process.env.PORT ?? 3000)`) -- el mismo puerto que usa
# `next dev` del frontend por defecto. Con los dos corriendo en local
# al mismo tiempo, uno de los dos gana el puerto 3000 y el otro queda
# aislado -- el sintoma real es que el frontend nunca llega al
# backend real y todo (busqueda de terminales, estadisticas, rutas,
# etc.) responde 404, sin ningun error visible que lo explique. Se
# separan los puertos: backend en 3001, frontend se queda en 3000 (ver
# NEXT_PUBLIC_API_URL en apps/web/.env.local.example, que debe
# apuntar a este mismo puerto).
PORT=3001

# Conexión con el rol de aplicación (ticketya_app) — sujeta a RLS de
# verdad. Se usa para todo lo que pertenece a una cooperativa específica.
DATABASE_URL=postgresql://ticketya_app:cambia_esta_contrasena_app@localhost:5432/ticketya

# Conexión con el rol de plataforma (ticketya_platform_admin) — con
# BYPASSRLS, ve todas las cooperativas a la vez. Se usa solo para
# lecturas que son legítimamente cross-tenant (búsqueda de viajes para
# pasajeros, dashboard de administración de plataforma).
DATABASE_URL_PUBLICO=postgresql://ticketya_platform_admin:cambia_esta_contrasena_admin@localhost:5432/ticketya

# Clave secreta para firmar los tokens de sesión (JWT). Debe ser un texto
# largo y aleatorio, distinto en cada entorno (desarrollo/producción).
# Nunca reutilices el mismo valor de ejemplo en producción.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-solo-tuyo

# Duración de la sesión del personal (vendedor y administradores).
# Opcional: si no existe, se usan 8h (un turno administrativo). El
# pasajero mantiene 60 minutos. Formato: "8h", "10h", etc.
# SESION_PERSONAL_DURACION=8h

# Monitoreo de errores en producción (Sentry, 28-jul-2026). Opcional en
# desarrollo local — si lo dejas vacío, el backend funciona igual, solo
# que no reporta errores a ningún lado. Consíguelo gratis en
# https://sentry.io/signup/ (plan gratuito real, no de prueba), creando
# un proyecto tipo "Node.js" o "NestJS", y copiando el DSN que te da.
SENTRY_DSN=

# Cifra el secreto TOTP del 2FA obligatorio de las cuentas
# administrativas (Ítem 19, Fase 3) -- sin esta variable, ningún admin
# puede activar 2FA (CifradorTotpAesGcm lanza error al primer intento).
# Cualquier texto largo y aleatorio sirve, se deriva a una clave real
# de 32 bytes internamente -- ej. generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANTE (12-oct-2026): esta misma clave también cifra, en la base, el número de
# cuenta de cobro de las cooperativas y el número de documento de discapacidad de los
# pasajeros (api/src/infraestructura/seguridad/datos-sensibles.ts). Debe estar configurada
# en el servidor ANTES de desplegar, y NO se puede cambiar después: los datos ya cifrados
# dejarían de poder leerse. Guárdala también en un lugar seguro fuera del servidor.
TOTP_CIFRADO_CLAVE=

# API key de Resend (resend.com, 16-sep-2026) -- envía los correos
# reales de recuperación de contraseña, verificación de cuenta y
# confirmación de compra (ResendNotificador, reemplaza al simulador que
# solo imprimía en consola). Requiere el dominio verificado en Resend
# (DKIM + registros de envío) -- ver Domains en el panel de Resend.
RESEND_API_KEY=

# Twilio (twilio.com, 16-sep-2026) -- envía los WhatsApp reales de
# recordatorio de viaje, aviso de llegada, cambio operativo y solicitud
# de calificación (TwilioNotificadorWhatsApp, reemplaza al simulador).
# Account SID y Auth Token están en la página principal de la consola
# de Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Mientras se usa el WhatsApp Sandbox gratuito (sin número propio de
# Ecuador todavía), este es el número del sandbox que te asignó Twilio,
# con el prefijo "whatsapp:" -- ej. whatsapp:+17372508034. Cuando haya
# un número real de WhatsApp Business aprobado por Meta, se reemplaza
# solo este valor, nada más del código cambia.
TWILIO_WHATSAPP_FROM=

# Orígenes del navegador autorizados a llamar a la API (CORS), separados por coma.
# Ya vienen incluidos https://klumbustech.com y https://www.klumbustech.com; esta variable
# solo sirve para agregar otros (por ejemplo, un sitio de vista previa). Fuera de
# producción también se acepta http://localhost en cualquier puerto.
# CORS_ORIGENES=https://vista-previa.klumbustech.com

# Dónde se guardan los archivos privados (comprobantes de pago), fuera de la carpeta pública.
# Si no se define, se usa api/uploads-privados. En el servidor conviene una ruta fuera del
# repositorio y incluida en las copias de seguridad, por ejemplo /var/lib/klumbus/privado.
# ARCHIVOS_PRIVADOS_DIR=/var/lib/klumbus/privado

# Dirección pública de la API, para armar los enlaces firmados de esos archivos.
# Si no se define, se usa https://api.klumbus.tech.
# URL_API_PUBLICA=http://localhost:3001
